{
  "name": "trek-fieldnotes-workspace",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "tsc --noEmit",
    "pack": "npm run build && trek-plugin pack dist/fieldnotes --out dist/fieldnotes.zip && trek-plugin pack dist/fieldnotes-trip --out dist/fieldnotes-trip.zip",
    "export": "npm run build && node scripts/export.cjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/markdown": "^1.7.2",
    "dompurify": "^3.3.0",
    "fflate": "0.8.3",
    "marked": "^17.0.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "jsdom": "^27.0.0",
    "trek-plugin-sdk": "1.7.0",
    "typescript": "^5.9.0"
  }
}
